---
import BachelierQuadrants from '../content/blogs/machine-learning/options-heat-diffusion-artifacts/BachelierQuadrants.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <style>
      :root {
        --foreground: #1b1b1b;
        --background: #ffffff;
        --maroon: #7a1f1f;
        --border: #e5e5e5;
      }
      body {
        margin: 0;
        background: var(--background);
        font-family: ui-sans-serif, system-ui, sans-serif;
        padding: 24px;
      }
      main {
        max-width: 900px;
        margin: 0 auto;
      }
      .ruler {
        height: 0;
        border-top: 1px dashed #ccc;
      }
    </style>
  </head>
  <body>
    <main>
      <BachelierQuadrants />
    </main>
  </body>
</html>
